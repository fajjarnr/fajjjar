---
interface Props {
  title: string;
  description: string;
  link: string;
  imgSrc?: string;
}

const { title, description, link, imgSrc } = Astro.props;
---

<a
  href={link}
  class="group block border-2 border-ink bg-white shadow-brutal-lg transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-brutal-xs dark:border-paper dark:bg-ink"
>
  {imgSrc && (
    <div class="aspect-video overflow-hidden border-b-2 border-ink dark:border-paper">
      <img
        src={imgSrc}
        alt={title}
        class="h-full w-full object-cover transition-transform group-hover:scale-105"
        loading="lazy"
      />
    </div>
  )}
  <div class="p-6">
    <h3 class="mb-2 font-display font-black text-lg uppercase tracking-tight text-ink group-hover:underline decoration-2 underline-offset-4 dark:text-paper">
      {title}
    </h3>
    <p class="text-sm font-normal text-ink/70 dark:text-paper/70">
      {description}
    </p>
  </div>
</a>
