---
interface Props {
  href: string;
  class?: string;
}

const { href, class: className = '' } = Astro.props;
const isExternal = href.startsWith('http');
---

<a
  href={href}
  class={`font-bold text-ink underline decoration-2 underline-offset-4 transition-all hover:decoration-4 dark:text-paper ${className}`}
  {...(isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <slot />
</a>
