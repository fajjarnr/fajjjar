---
import { siteMetadata } from '../data/siteMetadata';
---

<!-- Scroll to top button -->
<button
  id="scroll-top"
  type="button"
  aria-label="Scroll to top"
  class="fixed bottom-6 right-6 z-50 hidden border-2 border-ink bg-green p-3 text-ink shadow-[5px_5px_0_#111111] transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-[1px_1px_0_#111111] dark:border-paper dark:bg-green dark:text-ink"
>
  <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7" />
  </svg>
</button>

<!-- Comment section placeholder -->
<section id="comments" class="mx-auto max-w-[760px] px-4 py-8 sm:px-6">
  <h2 class="mb-4 border-b-[3px] border-ink pb-2 font-display text-xl font-black uppercase tracking-tight text-ink dark:border-paper dark:text-paper">
    Comments
  </h2>
  <div id="giscus-comment"></div>
</section>


<script is:inline>
  (function() {
    var scrollTopBtn = document.getElementById('scroll-top');

    function handleScroll() {
      if (!scrollTopBtn) return;
      if (window.scrollY > 300) {
        scrollTopBtn.classList.remove('hidden');
      } else {
        scrollTopBtn.classList.add('hidden');
      }
    }

    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();

    scrollTopBtn?.addEventListener('click', function() {
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });
  })();
</script>
