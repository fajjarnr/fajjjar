---
import { siteMetadata } from '../data/siteMetadata';
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle dark mode"
  class="flex items-center justify-center min-h-[44px] min-w-[44px] border-2 border-ink bg-yellow p-2 text-ink shadow-[5px_5px_0_#111111] transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-[1px_1px_0_#111111] dark:border-paper dark:bg-yellow dark:text-ink"
>
  <!-- Sun icon (shown in dark mode) -->
  <svg id="sun-icon" class="hidden h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
  </svg>
  <!-- Moon icon (shown in light mode) -->
  <svg id="moon-icon" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
  </svg>
</button>

<script is:inline>
  (function() {
    var toggle = document.getElementById('theme-toggle');
    var sun = document.getElementById('sun-icon');
    var moon = document.getElementById('moon-icon');

    function updateIcons() {
      var isDark = document.documentElement.classList.contains('dark');
      if (isDark) {
        sun?.classList.remove('hidden');
        moon?.classList.add('hidden');
      } else {
        sun?.classList.add('hidden');
        moon?.classList.remove('hidden');
      }
    }

    updateIcons();

    toggle?.addEventListener('click', function() {
      var isDark = document.documentElement.classList.toggle('dark');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      updateIcons();
    });
  })();
</script>
