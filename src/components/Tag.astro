---
interface Props {
  tag: string;
}

const { tag } = Astro.props;
---

<a
  href={`/tags/${tag}`}
  class="inline-flex items-center justify-center min-h-[44px] border-2 border-ink bg-cyan px-3 py-2 text-sm font-mono font-bold text-ink uppercase shadow-[3px_3px_0_#111111] transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none hover:bg-cyan dark:border-paper dark:bg-cyan dark:text-ink"
>
  #{tag}
</a>
