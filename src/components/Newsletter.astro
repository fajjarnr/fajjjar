---
import { siteMetadata } from '../data/siteMetadata';

interface Props {
  provider?: string;
}

const { provider = siteMetadata.newsletter.provider } = Astro.props;

// Buttondown takes a plain form POST, so the form works with JavaScript
// disabled. The inline handler below only intercepts to show progress and a
// failure state; without it the browser posts and Buttondown handles the rest.
const username = siteMetadata.newsletter.buttondownUser;
const action = username
  ? `https://buttondown.email/api/emails/embed-subscribe/${username}`
  : '';
---

<div class="border-2 border-ink bg-white p-6 shadow-brutal-lg dark:border-paper dark:bg-ink">
  <h3 class="mb-2 font-display font-black text-xl uppercase tracking-tight text-ink dark:text-paper">
    Subscribe to the Newsletter
  </h3>
  <p class="mb-4 text-sm font-normal text-ink/70 dark:text-paper/70">
    New posts on OpenShift, Kubernetes, and running platforms in production. No schedule, no noise.
  </p>

  {
    action ? (
      <form
        id="newsletter-form"
        action={action}
        method="post"
        target="newsletter-sink"
        class="flex flex-col gap-4 sm:flex-row"
      >
        <label for="newsletter-email" class="sr-only">
          Email address
        </label>
        <input
          id="newsletter-email"
          type="email"
          name="email"
          placeholder="you@example.com"
          required
          autocomplete="email"
          class="flex-1 border-2 border-ink bg-white px-4 py-3 text-sm font-bold text-ink shadow-brutal-md placeholder:font-normal placeholder:text-ink/50 focus:outline-none focus:ring-0 dark:border-paper dark:bg-ink dark:text-paper dark:placeholder:text-paper/50"
        />
        <button
          id="newsletter-submit"
          type="submit"
          class="border-2 border-ink bg-pink px-6 py-3 text-sm font-bold uppercase text-ink shadow-brutal-md transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-brutal-xs disabled:cursor-not-allowed disabled:opacity-70 dark:border-paper dark:bg-pink dark:text-ink"
        >
          Subscribe
        </button>
      </form>
    ) : (
      <p class="border-2 border-dashed border-ink p-4 font-mono text-xs font-bold uppercase dark:border-paper">
        Set PUBLIC_BUTTONDOWN_USER to enable this form
      </p>
    )
  }

  <!-- Buttondown renders its confirmation here, so the reader never leaves the
       article. The form degrades to a normal POST without JavaScript. -->
  <iframe
    name="newsletter-sink"
    title="Newsletter subscription result"
    class="mt-4 hidden h-0 w-0 border-0"
    aria-hidden="true"
  ></iframe>

  <p
    id="newsletter-note"
    role="status"
    class="mt-3 hidden border-2 border-ink px-3 py-2 font-mono text-xs font-bold uppercase dark:border-paper"
  ></p>
</div>

<script is:inline>
  (function () {
    var form = document.getElementById('newsletter-form');
    if (!form) return;

    var input = document.getElementById('newsletter-email');
    var submit = document.getElementById('newsletter-submit');
    var note = document.getElementById('newsletter-note');
    var sink = form.querySelector('iframe');

    function say(message, ok) {
      if (!note) return;
      note.textContent = message;
      note.classList.remove('hidden');
      note.classList.toggle('bg-green', Boolean(ok));
      note.classList.toggle('bg-red', !ok);
    }

    form.addEventListener('submit', function () {
      if (submit) {
        submit.disabled = true;
        submit.textContent = 'Sending\u2026';
      }
    });

    // The response lands in the hidden iframe, so the reader stays in place.
    if (sink) {
      sink.addEventListener('load', function () {
        if (!sink.dataset.armed) return; // ignore the initial about:blank
        var failed = false;
        try {
          var text = sink.contentDocument && sink.contentDocument.body
            ? sink.contentDocument.body.textContent || ''
            : '';
          failed = /error|invalid|already/i.test(text);
        } catch (e) {
          // Cross-origin response: Buttondown accepted it.
          failed = false;
        }
        if (failed) {
          say('That address was not accepted \u2014 check it and try again.', false);
          if (submit) {
            submit.disabled = false;
            submit.textContent = 'Subscribe';
          }
        } else {
          say('Check your inbox to confirm the subscription.', true);
          form.reset();
        }
      });
      form.addEventListener('submit', function () {
        sink.dataset.armed = '1';
      });
    }
  })();
</script>
