---
import { Image as AstroImage } from 'astro:assets';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  class?: string;
}

const { src, alt, width, height, class: className = '' } = Astro.props;
---

<AstroImage
  src={src}
  alt={alt}
  width={width}
  height={height}
  class={`border-2 border-ink shadow-[5px_5px_0_#111111] dark:border-paper ${className}`}
  loading="lazy"
/>
