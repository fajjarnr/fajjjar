---
import { getCollection } from 'astro:content';
import LayoutWrapper from '../../components/LayoutWrapper.astro';
import PageTitle from '../../components/PageTitle.astro';
import SectionContainer from '../../components/SectionContainer.astro';

const projects = await getCollection('projects');

const accentCycle = ['bg-yellow', 'bg-pink', 'bg-cyan', 'bg-green', 'bg-red'];
---

<LayoutWrapper title="Projects and tools I have built" description="Things I have built for platform engineering and infrastructure work, from Astro sites to Kubernetes tooling." url="/projects/">
  <SectionContainer>
    <PageTitle title="Projects" description={`${projects.length} projects and counting`} />

    {projects.length === 0 && (
      <p class="border-2 border-dashed border-ink p-6 font-bold dark:border-paper">
        No projects yet.
      </p>
    )}

    <ul class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {projects.map((project, i) => (
        <li
          class="group border-2 border-ink bg-white p-6 shadow-brutal-md transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-brutal-xs dark:border-paper dark:bg-ink"
        >
          <div class="flex items-start justify-between gap-4">
            <div class="min-w-0">
              <h2 class="font-display text-xl font-black uppercase tracking-tight text-ink dark:text-paper">
                <a
                  href={project.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:underline decoration-2 underline-offset-4"
                >
                  {project.data.title}
                </a>
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-ink/70 dark:text-paper/70">
                {project.data.description}
              </p>
            </div>
            <span class={`shrink-0 border-2 border-ink px-2 py-1 font-mono text-xs font-black uppercase dark:border-paper ${accentCycle[i % accentCycle.length]}`}>
              {String(i + 1).padStart(2, '0')}
            </span>
          </div>

          <div class="mt-4 flex items-center gap-2">
            <a
              href={project.data.link}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1 border-2 border-ink bg-white px-3 py-1 font-mono text-xs font-bold uppercase text-ink transition-all hover:bg-yellow dark:border-paper dark:bg-ink dark:text-paper"
            >
              View →
            </a>
          </div>
        </li>
      ))}
    </ul>
  </SectionContainer>
</LayoutWrapper>
