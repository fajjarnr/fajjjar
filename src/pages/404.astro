---
import { getCollection } from 'astro:content';
import LayoutWrapper from '../components/LayoutWrapper.astro';

// Real numbers for the readout below: the fault report should point somewhere.
const posts = await getCollection('blog', ({ data }) => !data.draft);
---

<LayoutWrapper title="404 — Page not found" description="That page does not exist, or it moved somewhere else." url="/404/">
  <section class="mx-auto flex max-w-[760px] flex-col items-center px-4 py-20 sm:px-6 sm:py-32 reveal">
    <!-- Fault report: what was requested, what came back, what is still available -->
    <div class="readout readout--fault w-full text-left">
      <div class="readout-head">
        <span class="readout-tag">Fault</span>
        <span class="ml-auto truncate">Route not found</span>
      </div>
      <div class="readout-body grid gap-1">
        <div class="flex flex-wrap items-baseline justify-between gap-x-4">
          <span class="text-ink/70 dark:text-paper/70">Requested</span>
          <span id="fault-path" class="min-w-0 truncate normal-case">/</span>
        </div>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4">
          <span class="text-ink/70 dark:text-paper/70">Response</span>
          <span>404 — not found</span>
        </div>
        <div class="flex flex-wrap items-baseline justify-between gap-x-4">
          <span class="text-ink/70 dark:text-paper/70">Index</span>
          <span>{posts.length} documents available</span>
        </div>
      </div>
    </div>

    <p class="mt-10 font-display font-black uppercase leading-none tracking-tight text-ink dark:text-paper text-7xl sm:text-9xl md:text-[11rem]">
      404
    </p>

    <h1 class="mt-6 font-display font-black uppercase tracking-tight text-3xl text-ink dark:text-paper sm:text-5xl">
      Page not found
    </h1>

    <p class="mt-5 max-w-lg text-lg font-bold text-ink/70 dark:text-paper/70">
      That page does not exist, or it moved somewhere else.
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-4">
      <a
        href="/"
        class="border-2 border-ink bg-yellow px-6 py-3 font-black uppercase shadow-brutal-md transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-brutal-xs dark:border-paper"
      >
        Back home
      </a>
      <a
        href="/blog"
        class="border-2 border-ink bg-cyan px-6 py-3 font-black uppercase shadow-brutal-md transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-brutal-xs dark:border-paper"
      >
        Browse the blog
      </a>
      <button
        id="fault-search"
        type="button"
        class="border-2 border-ink bg-white px-6 py-3 font-black uppercase text-ink shadow-brutal-md transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-brutal-xs dark:border-paper dark:bg-ink dark:text-paper"
      >
        Search instead
      </button>
    </div>
  </section>

  <script is:inline>
    (function () {
      var path = document.getElementById('fault-path');
      if (path) path.textContent = window.location.pathname;

      var search = document.getElementById('fault-search');
      var trigger = document.getElementById('search-trigger');
      if (search && trigger) {
        search.addEventListener('click', function () {
          trigger.click();
        });
      }
    })();
  </script>
</LayoutWrapper>
