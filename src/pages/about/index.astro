---
import { getEntry, render } from 'astro:content';
import LayoutWrapper from '../../components/LayoutWrapper.astro';
import SocialIcons from '../../components/SocialIcons.astro';

const author = await getEntry('authors', 'default');
const { Content } = await render(author);

const { name, avatar, occupation, company, email, twitter, github, linkedin } = author.data;
---

<LayoutWrapper title={`About ${name} — DevOps and platform engineer`} description={`${name} — DevOps and platform engineer working on OpenShift, Kubernetes, and automation.`} url="/about/">
  <div class="mx-auto max-w-[760px] px-4 py-12 sm:px-6">
    <!-- Hero card -->
    <div class="border-2 border-ink bg-white p-6 shadow-brutal-lg dark:border-paper dark:bg-ink sm:p-8">
      <div class="flex flex-col items-start gap-6 sm:flex-row sm:items-center">
        {avatar && (
          <img
            src={avatar}
            alt={name}
            class="h-24 w-24 border-4 border-ink bg-paper-muted object-cover shadow-brutal-md dark:border-paper dark:bg-ink sm:h-32 sm:w-32"
          />
        )}
        <div>
          <h1 class="font-display text-4xl font-black uppercase tracking-tight text-ink dark:text-paper sm:text-5xl">
            {name}
          </h1>
          {(occupation || company) && (
            <p class="mt-2 text-lg font-bold text-ink/70 dark:text-paper/70">
              {[occupation, company].filter(Boolean).join(' @ ')}
            </p>
          )}
          <div class="mt-4">
            <SocialIcons
              links={{
                github,
                twitter,
                linkedin,
                email: email ? `mailto:${email}` : undefined,
              }}
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Bio -->
    <div class="about-prose prose mt-8 max-w-none border-2 border-ink bg-white p-6 shadow-brutal-md dark:border-paper dark:bg-ink sm:p-8">
      <Content />
    </div>

    <!-- Skills / interests -->
    <div class="mt-8 border-2 border-ink bg-yellow p-6 shadow-brutal-md dark:border-paper">
      <h2 class="font-display text-lg font-black uppercase tracking-tight text-ink">
        What I write about
      </h2>
      <div class="mt-4 flex flex-wrap gap-2">
        {['OpenShift', 'Kubernetes', 'AWS', 'Terraform', 'Ansible', 'CI/CD', 'Linux', 'Networking', 'Observability', 'Containers'].map((tag) => (
          <span class="inline-block border-2 border-ink bg-white px-3 py-1 font-mono text-xs font-bold uppercase text-ink dark:border-paper dark:bg-ink dark:text-paper">
            {tag}
          </span>
        ))}
      </div>
    </div>

    <!-- Career -->
    <div class="mt-8 border-2 border-ink bg-white p-6 shadow-brutal-md dark:border-paper dark:bg-ink">
      <h2 class="font-display text-lg font-black uppercase tracking-tight text-ink dark:text-paper">
        Career
      </h2>
      <div class="mt-4 border-2 border-ink bg-paper-muted p-4 shadow-brutal-sm dark:border-paper dark:bg-ink">
        <p class="font-bold text-ink dark:text-paper">DevOps Engineer — PT Mastersystem Infotama</p>
        <p class="mt-1 font-mono text-xs font-bold uppercase text-ink/70 dark:text-paper/70">2023 — present</p>
        <ul class="mt-3 space-y-1 text-sm text-ink/70 dark:text-paper/70">
          <li>├─ Operating and maintaining Red Hat OpenShift clusters and Linux systems.</li>
          <li>├─ Building automation and CI/CD pipelines for containerized application deployment.</li>
          <li>└─ Monitoring, troubleshooting, and keeping the platform reliable.</li>
        </ul>
      </div>
    </div>

    <!-- Certifications -->
    <div class="mt-8 border-2 border-ink bg-cyan p-6 shadow-brutal-md dark:border-paper">
      <h2 class="font-display text-lg font-black uppercase tracking-tight text-ink">
        Certifications
      </h2>
      <div class="mt-4 grid gap-3 sm:grid-cols-2">
        {[
          'Red Hat Certified Architect in OpenShift',
          'Red Hat Certified Specialist in OpenShift Virtualization',
          'Red Hat Certified Specialist in MultiCluster Management',
          'Red Hat Certified Specialist in OpenShift Data Foundation',
          'Red Hat Certified Engineer in OpenShift',
          'Red Hat Certified System Administrator (RHCSA)',
        ].map((cert) => (
          <div class="border-2 border-ink bg-white p-3 dark:border-paper dark:bg-ink">
            <p class="text-sm font-bold text-ink dark:text-paper">{cert}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</LayoutWrapper>
