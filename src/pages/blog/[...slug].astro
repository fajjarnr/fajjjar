---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import LayoutWrapper from '../../components/LayoutWrapper.astro';
import PostFooter from '../../components/PostFooter.astro';
import { formatDateLong, readingTime, slugTag } from '../../utils/blog';
import { siteMetadata } from '../../data/siteMetadata';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const {
  title,
  description,
  date,
  lastmod,
  tags,
  authors: authorIds,
  images,
  layout,
  canonicalUrl,
} = entry.data;

const url = canonicalUrl ?? `/blog/${entry.slug}/`;

const readingMinutes = readingTime(entry.body);

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const resolvedAuthors = (
  await Promise.all(authorIds.map((id) => getEntry('authors', id)))
).filter((a): a is NonNullable<typeof a> => Boolean(a));

const shareUrl = new URL(url, siteMetadata.siteUrl).href;
const shareText = encodeURIComponent(title);
const banner = layout === 'PostBanner' ? images?.[0] : undefined;
---

<LayoutWrapper
  title={title}
  description={description ?? ''}
  url={url}
  type="article"
  publishedTime={date.toISOString()}
  tags={tags}
>
  <article class="post-prose prose mx-auto max-w-[760px] px-4 py-12 sm:px-6">
    {tags.length > 0 && (
      <div class="mb-6 flex flex-wrap gap-2">
        {tags.map((tag) => (
          <a
            href={`/tags/${slugTag(tag)}/`}
            class="inline-block border-2 border-ink bg-yellow px-3 py-1 font-mono text-xs font-bold uppercase text-ink shadow-[3px_3px_0_#111111] transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none dark:border-paper"
          >
            {tag}
          </a>
        ))}
      </div>
    )}

    <!-- Title -->
    <h1 class="font-display text-4xl font-black uppercase leading-tight tracking-tight text-ink dark:text-paper sm:text-5xl">
      {title}
    </h1>

    <!-- Meta -->
    <div class="mt-6 flex flex-wrap items-center gap-3 text-xs font-bold uppercase text-ink/70 dark:text-paper/70">
      <time datetime={date.toISOString()}>{formatDateLong(date)}</time>
      {lastmod && (
        <span>
          Updated {formatDateLong(lastmod)}
        </span>
      )}
      <span>
        {readingMinutes} min read
      </span>
    </div>

    <!-- Banner image -->
    {banner && (
      <div class="mt-8 overflow-hidden border-[3px] border-ink shadow-[7px_7px_0_#111111] dark:border-paper">
        <img src={banner} alt={title} class="w-full object-cover" />
      </div>
    )}

    <!-- Content -->
    <Content />
    <!-- Tags -->
    {tags.length > 0 && (
      <div class="mt-12 border-2 border-ink bg-white p-5 shadow-[5px_5px_0_#111111] dark:border-paper dark:bg-ink">
        <h2 class="font-display text-lg font-black uppercase tracking-tight text-ink dark:text-paper">
          Tags
        </h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a
              href={`/tags/${slugTag(tag)}/`}
              class="inline-block border-2 border-ink bg-cyan px-3 py-1 font-mono text-xs font-bold uppercase text-ink shadow-[3px_3px_0_#111111] transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none dark:border-paper"
            >
              #{tag}
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Table of contents -->
    {toc.length > 0 && (
      <nav class="mt-6 border-2 border-ink bg-white p-5 shadow-[5px_5px_0_#111111] dark:border-paper dark:bg-ink">
        <h2 class="font-display text-lg font-black uppercase tracking-tight text-ink dark:text-paper">
          On this page
        </h2>
        <ul class="mt-3 space-y-2">
          {toc.map((heading) => (
            <li key={heading.slug} class={heading.depth === 3 ? 'ml-4' : ''}>
              <a
                href={`#${heading.slug}`}
                class="font-bold text-ink underline decoration-2 underline-offset-4 hover:decoration-4 dark:text-paper"
              >
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    )}

    <!-- Share -->
    <div class="mt-6 border-2 border-ink bg-white p-5 shadow-[5px_5px_0_#111111] dark:border-paper dark:bg-ink">
      <h2 class="font-display text-lg font-black uppercase tracking-tight text-ink dark:text-paper">
        Share
      </h2>
      <div class="mt-3 flex flex-wrap gap-3">
        <a
          href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`}
          target="_blank"
          rel="noopener noreferrer"
          class="border-2 border-ink bg-cyan px-4 py-2 text-xs font-bold uppercase text-ink shadow-[3px_3px_0_#111111] transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none dark:border-paper"
        >
          Twitter
        </a>
        <a
          href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
          target="_blank"
          rel="noopener noreferrer"
          class="border-2 border-ink bg-green px-4 py-2 text-xs font-bold uppercase text-ink shadow-[3px_3px_0_#111111] transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none dark:border-paper"
        >
          LinkedIn
        </a>
        <a
          href={`mailto:?subject=${shareText}&body=${shareUrl}`}
          class="border-2 border-ink bg-pink px-4 py-2 text-xs font-bold uppercase text-ink shadow-[3px_3px_0_#111111] transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none dark:border-paper"
        >
          Email
        </a>
      </div>
    </div>

    <!-- Author + Newsletter + Comments -->
    <PostFooter authors={resolvedAuthors} />
  </article>
</LayoutWrapper>

