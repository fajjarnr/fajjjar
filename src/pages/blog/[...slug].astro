---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import LayoutWrapper from '../../components/LayoutWrapper.astro';
import PostFooter from '../../components/PostFooter.astro';
import ReadingInstrument from '../../components/ReadingInstrument.astro';
import { formatDate, formatDateLong, readingTime, slugTag } from '../../utils/blog';
import { siteMetadata } from '../../data/siteMetadata';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const {
  title,
  description,
  date,
  lastmod,
  tags,
  authors: authorIds,
  images,
  layout,
  canonicalUrl,
} = entry.data;

const url = canonicalUrl ?? `/blog/${entry.slug}/`;

const readingMinutes = readingTime(entry.body);

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const resolvedAuthors = (
  await Promise.all(authorIds.map((id) => getEntry('authors', id)))
).filter((a): a is NonNullable<typeof a> => Boolean(a));

const shareUrl = new URL(url, siteMetadata.siteUrl).href;
const shareText = encodeURIComponent(title);
const banner = layout === 'PostBanner' ? images?.[0] : undefined;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const relatedPosts = allPosts
  .filter((p) => p.slug !== entry.slug)
  .map((p) => ({
    ...p,
    commonTags: p.data.tags.filter((t) => tags.includes(t)).length,
  }))
  .sort((a, b) => b.commonTags - a.commonTags || b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<LayoutWrapper
  title={title}
  description={description ?? ''}
  url={url}
  type="article"
  publishedTime={date.toISOString()}
  tags={tags}
>
  <div class="mx-auto max-w-[1180px] px-4 py-12 sm:px-6">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_320px]">
      <!-- Main content -->
      <article class="post-prose prose min-w-0 max-w-none">
        <!-- Category badges -->
        {tags.length > 0 && (
          <div class="mb-6 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <a
                href={`/tags/${slugTag(tag)}/`}
                class="inline-block border-2 border-ink bg-yellow px-3 py-1 font-mono text-xs font-bold uppercase text-ink shadow-brutal-sm transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none dark:border-paper"
              >
                {tag}
              </a>
            ))}
          </div>
        )}

        <!-- Title -->
        <h1 class="font-display text-4xl font-black uppercase leading-tight tracking-tight text-ink dark:text-paper sm:text-5xl break-words">
          {title}
        </h1>

        <!-- Meta -->
        <div class="mt-6 flex flex-wrap items-center gap-3 text-xs font-bold uppercase text-ink/70 dark:text-paper/70">
          <time datetime={date.toISOString()}>{formatDateLong(date)}</time>
          {lastmod && (
            <span>
              Updated {formatDateLong(lastmod)}
            </span>
          )}
          <span>
            {readingMinutes} min read
          </span>
        </div>

        <!-- Banner image -->
        {banner && (
          <div class="mt-8 overflow-hidden border-[3px] border-ink shadow-brutal-lg dark:border-paper">
            <img src={banner} alt={title} class="w-full object-cover" />
          </div>
        )}

        <!-- Content -->
        <div class="mt-12">
          <Content />
        </div>

        <!-- Reading telemetry: where the reader is, how much is left -->
        <div class="mt-16">
          <ReadingInstrument minutes={readingMinutes} />
        </div>

        <!-- Related posts -->
        {relatedPosts.length > 0 && (
          <div class="mt-16 border-t-4 border-ink pt-8 dark:border-paper">
            <h2 class="font-display text-lg font-black uppercase tracking-tight text-ink dark:text-paper">
              Related posts
            </h2>
            <ul class="mt-6 grid gap-4 sm:grid-cols-3">
              {relatedPosts.map((post) => (
                <li>
                  <a
                    href={`/blog/${post.slug}/`}
                    class="block border-2 border-ink bg-white p-4 shadow-brutal-sm transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-brutal-xs dark:border-paper dark:bg-ink"
                  >
                    <p class="font-mono text-xs font-bold uppercase text-ink/70 dark:text-paper/70">
                      {formatDate(post.data.date)}
                    </p>
                    <h3 class="mt-2 font-display text-sm font-black uppercase tracking-tight text-ink dark:text-paper">
                      {post.data.title}
                    </h3>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Author + Newsletter + Comments -->
        <PostFooter authors={resolvedAuthors} />
      </article>

      <!-- Sticky sidebar -->
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-6">
          <!-- Table of contents -->
          {toc.length > 0 && (
            <nav class="border-2 border-ink bg-white p-5 shadow-brutal-md dark:border-paper dark:bg-ink">
              <h2 class="font-display text-sm font-black uppercase tracking-tight text-ink dark:text-paper">
                On this page
              </h2>
              <ul class="mt-3 space-y-2">
                {toc.map((heading) => (
                  <li key={heading.slug} class={heading.depth === 3 ? 'ml-4' : ''}>
                    <a
                      href={`#${heading.slug}`}
                      class="font-bold text-sm text-ink underline decoration-2 underline-offset-4 hover:decoration-4 dark:text-paper"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          <!-- Tags -->
          {tags.length > 0 && (
            <div class="border-2 border-ink bg-white p-5 shadow-brutal-md dark:border-paper dark:bg-ink">
              <h2 class="font-display text-sm font-black uppercase tracking-tight text-ink dark:text-paper">
                Tags
              </h2>
              <div class="mt-3 flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <a
                    href={`/tags/${slugTag(tag)}/`}
                    class="inline-block border-2 border-ink bg-cyan px-2 py-1 font-mono text-xs font-bold uppercase text-ink transition-all hover:translate-x-[2px] hover:translate-y-[2px] dark:border-paper"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Share -->
          <div class="border-2 border-ink bg-white p-5 shadow-brutal-md dark:border-paper dark:bg-ink">
            <h2 class="font-display text-sm font-black uppercase tracking-tight text-ink dark:text-paper">
              Share
            </h2>
            <div class="mt-3 flex flex-wrap gap-2">
              <a
                href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`}
                target="_blank"
                rel="noopener noreferrer"
                class="border-2 border-ink bg-cyan px-3 py-2 text-xs font-bold uppercase text-ink shadow-brutal-sm transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none dark:border-paper"
              >
                Twitter
              </a>
              <a
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="border-2 border-ink bg-green px-3 py-2 text-xs font-bold uppercase text-ink shadow-brutal-sm transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none dark:border-paper"
              >
                LinkedIn
              </a>
              <a
                href={`mailto:?subject=${shareText}&body=${shareUrl}`}
                class="border-2 border-ink bg-pink px-3 py-2 text-xs font-bold uppercase text-ink shadow-brutal-sm transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none dark:border-paper"
              >
                Email
              </a>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>

</LayoutWrapper>
