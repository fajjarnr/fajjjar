---
import { getCollection, getEntry, render, type CollectionEntry } from 'astro:content';
import LayoutWrapper from '../../components/LayoutWrapper.astro';
import PostFooter from '../../components/PostFooter.astro';
import ProseEnhancements from '../../components/ProseEnhancements.astro';
import { formatDate, formatDateLong, readingTime, slugTag } from '../../utils/blog';
import { relatedPosts, seriesFor } from '../../utils/series';
import { siteMetadata } from '../../data/siteMetadata';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const {
  title,
  summary,
  date,
  lastmod,
  tags,
  authors: authorIds,
  images,
  layout,
  canonicalUrl,
} = entry.data;

const url = canonicalUrl ?? `/blog/${entry.slug}/`;

const readingMinutes = readingTime(entry.body);

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const resolvedAuthors = (
  await Promise.all(authorIds.map((id) => getEntry('authors', id)))
).filter((a): a is NonNullable<typeof a> => Boolean(a));

const shareUrl = new URL(url, siteMetadata.siteUrl).href;
const shareText = encodeURIComponent(title);
const banner = layout === 'PostBanner' ? images?.[0] : undefined;

const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const related = relatedPosts(entry, allPosts, 3);
const series = seriesFor(entry, allPosts);

// Inside a series, prev/next follow the series and never leave it — the ends
// are ends, not a jump back into the archive. Standalone posts walk the whole
// archive in date order.
const byDate = [...allPosts].sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const position = byDate.findIndex((p) => p.slug === entry.slug);
const previous = series ? series.previous : position > 0 ? byDate[position - 1] : null;
const next = series ? series.next : position < byDate.length - 1 ? byDate[position + 1] : null;
---

<LayoutWrapper
  title={title}
  description={summary ?? ''}
  url={url}
  type="article"
  publishedTime={date.toISOString()}
  tags={tags}
>
  <div class="mx-auto max-w-[1180px] px-4 py-12 sm:px-6">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1fr_320px]">
      <!-- Main content -->
      <article class="post-prose prose min-w-0 max-w-none">
        <!-- Category badges -->
        {tags.length > 0 && (
          <div class="mb-6 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <a
                href={`/tags/${slugTag(tag)}/`}
                class="inline-block border-2 border-ink bg-yellow px-3 py-1 font-mono text-xs font-bold uppercase text-ink shadow-brutal-sm transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-none dark:border-paper"
              >
                {tag}
              </a>
            ))}
          </div>
        )}

        <!-- Title and meta sit flush with the tag row and the panel's outer
             edge. The panel's own padding insets its body text, which is the
             intended hierarchy: the heading is the container's label, the
             prose is its contents. -->
        <!-- Title. Line-height lives in global.css, not here: Tailwind's
             text-5xl also emits a line-height and wins over leading-*. -->
        <h1 class="font-display text-4xl font-black uppercase italic tracking-tight text-ink underline decoration-4 underline-offset-[10px] dark:text-paper sm:text-5xl break-words">
          {title}
        </h1>

        <!-- Meta: same chip treatment the listing cards use, so a date reads
             the same wherever it appears. Date is the bordered chip, reading
             time carries the information accent. -->
        <div class="mt-6 flex flex-wrap items-center gap-2 font-mono text-xs font-black uppercase">
          <time datetime={date.toISOString()} class="border-2 border-ink px-2 py-1 text-ink dark:border-paper dark:text-paper">
            {formatDateLong(date)}
          </time>
          {lastmod && (
            <span class="border-2 border-ink px-2 py-1 text-ink dark:border-paper dark:text-paper">
              Updated {formatDateLong(lastmod)}
            </span>
          )}
          <span class="border-2 border-ink bg-cyan px-2 py-1 text-ink dark:border-paper dark:bg-cyan dark:text-ink">
            {readingMinutes} min read
          </span>
        </div>

        <!-- Banner image -->
        {banner && (
          <div class="mt-8 overflow-hidden border-[3px] border-ink shadow-brutal-lg dark:border-paper">
            <img src={banner} alt={title} class="w-full object-cover" />
          </div>
        )}

        <!-- Series position, when this post is part of one -->
        {series && (
          <div class="mt-8 flex flex-wrap items-center gap-3 border-2 border-ink bg-paper-muted px-4 py-3 shadow-brutal-sm dark:border-paper dark:bg-ink">
            <span class="border-2 border-ink bg-cyan px-2 py-1 font-mono text-xs font-black uppercase text-ink dark:border-paper dark:bg-cyan dark:text-ink">
              Part {series.position} of {series.total}
            </span>
            <a
              href="/series/"
              class="font-display text-sm font-black uppercase tracking-tight text-ink underline decoration-2 underline-offset-4 hover:decoration-4 dark:text-paper"
            >
              {series.name}
            </a>
          </div>
        )}

        <!-- Content: Panel White, bounded by the system's 2px rule and a Brutal
             MD shadow, so the prose column reads as a raised surface like every
             other panel. Padding matches the card tier (24px, 32px from sm). -->
        <div class="mt-12 border-2 border-ink bg-white p-6 shadow-brutal-md dark:border-paper dark:bg-ink sm:p-8">
          <Content />
        </div>

        <!-- Prev / next through the archive, or through the series -->
        {(previous || next) && (
          <nav aria-label="Post navigation" class="mt-16 grid gap-4 border-t-4 border-ink pt-8 dark:border-paper sm:grid-cols-2">
            {previous ? (
              <a
                href={`/blog/${previous.slug}/`}
                rel="prev"
                class="group border-2 border-ink bg-white p-4 shadow-brutal-sm transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-brutal-xs dark:border-paper dark:bg-ink"
              >
                <span class="font-mono text-xs font-bold uppercase text-ink/70 dark:text-paper/70">
                  &larr; Previous
                </span>
                <span class="mt-2 block font-display text-sm font-black uppercase tracking-tight text-ink group-hover:underline decoration-2 underline-offset-4 dark:text-paper">
                  {previous.data.title}
                </span>
              </a>
            ) : (
              <span class="hidden sm:block" />
            )}
            {next && (
              <a
                href={`/blog/${next.slug}/`}
                rel="next"
                class="group border-2 border-ink bg-white p-4 shadow-brutal-sm transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-brutal-xs dark:border-paper dark:bg-ink sm:text-right"
              >
                <span class="font-mono text-xs font-bold uppercase text-ink/70 dark:text-paper/70">
                  Next &rarr;
                </span>
                <span class="mt-2 block font-display text-sm font-black uppercase tracking-tight text-ink group-hover:underline decoration-2 underline-offset-4 dark:text-paper">
                  {next.data.title}
                </span>
              </a>
            )}
          </nav>
        )}

        <!-- Related posts, ranked by tag overlap then shared title words -->
        {related.length > 0 && (
          <div class="not-prose mt-16 border-t-4 border-ink pt-8 dark:border-paper">
            <h2 class="font-display text-lg font-black uppercase tracking-tight text-ink dark:text-paper">
              Related posts
            </h2>
            <ul class="mt-6 grid gap-4 sm:grid-cols-3">
              {related.map((post) => (
                <li>
                  <a
                    href={`/blog/${post.slug}/`}
                    class="group block border-2 border-ink bg-white p-4 shadow-brutal-sm transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-brutal-xs dark:border-paper dark:bg-ink"
                  >
                    <p class="font-mono text-xs font-bold uppercase text-ink/70 dark:text-paper/70">
                      {formatDate(post.data.date)}
                    </p>
                    <h3 class="mt-2 font-display text-sm font-black uppercase tracking-tight text-ink decoration-2 underline-offset-4 group-hover:underline dark:text-paper">
                      {post.data.title}
                    </h3>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )}

        <!-- Author + Newsletter + Comments -->
        <PostFooter authors={resolvedAuthors} />
      </article>

      <!-- Sticky sidebar -->
      <aside class="hidden lg:block">
        <div class="sticky top-24 space-y-6">
          <!-- Table of contents -->
          {toc.length > 0 && (
            <nav class="border-2 border-ink bg-white p-5 shadow-brutal-md dark:border-paper dark:bg-ink">
              <h2 class="font-display text-sm font-black uppercase tracking-tight text-ink dark:text-paper">
                On this page
              </h2>
              <ul class="mt-3 space-y-2">
                {toc.map((heading) => (
                  <li key={heading.slug} class={heading.depth === 3 ? 'ml-4' : ''}>
                    <a
                      href={`#${heading.slug}`}
                      class="font-bold text-sm text-ink underline decoration-2 underline-offset-4 hover:decoration-4 dark:text-paper"
                    >
                      {heading.text}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          )}

          <!-- Tags -->
          {tags.length > 0 && (
            <div class="border-2 border-ink bg-white p-5 shadow-brutal-md dark:border-paper dark:bg-ink">
              <h2 class="font-display text-sm font-black uppercase tracking-tight text-ink dark:text-paper">
                Tags
              </h2>
              <div class="mt-3 flex flex-wrap gap-2">
                {tags.map((tag) => (
                  <a
                    href={`/tags/${slugTag(tag)}/`}
                    class="inline-block border-2 border-ink bg-cyan px-2 py-1 font-mono text-xs font-bold uppercase text-ink transition-all hover:translate-x-[2px] hover:translate-y-[2px] dark:border-paper"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Share -->
          <div class="border-2 border-ink bg-white p-5 shadow-brutal-md dark:border-paper dark:bg-ink">
            <h2 class="font-display text-sm font-black uppercase tracking-tight text-ink dark:text-paper">
              Share
            </h2>
            <div class="mt-3 flex flex-wrap gap-2">
              <a
                href={`https://twitter.com/intent/tweet?url=${shareUrl}&text=${shareText}`}
                target="_blank"
                rel="noopener noreferrer"
                class="border-2 border-ink bg-cyan px-3 py-2 text-xs font-bold uppercase text-ink shadow-brutal-sm transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none dark:border-paper"
              >
                Twitter
              </a>
              <a
                href={`https://www.linkedin.com/sharing/share-offsite/?url=${shareUrl}`}
                target="_blank"
                rel="noopener noreferrer"
                class="border-2 border-ink bg-green px-3 py-2 text-xs font-bold uppercase text-ink shadow-brutal-sm transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none dark:border-paper"
              >
                LinkedIn
              </a>
              <a
                href={`mailto:?subject=${shareText}&body=${shareUrl}`}
                class="border-2 border-ink bg-pink px-3 py-2 text-xs font-bold uppercase text-ink shadow-brutal-sm transition-all hover:translate-x-[2px] hover:translate-y-[2px] hover:shadow-none dark:border-paper"
              >
                Email
              </a>
            </div>
          </div>
        </div>
      </aside>
    </div>
  </div>


<!-- Copy buttons and heading anchors for the prose above. -->
<ProseEnhancements />

<!-- Reading progress: a hairline at the very top of the viewport, filled in
     the action colour. No panel, no label — just the position in the page. -->
<div class="fixed top-0 left-0 right-0 z-[60] h-1 bg-transparent" aria-hidden="true">
  <div id="reading-progress" class="h-full bg-pink transition-[width] duration-100" style="width: 0%"></div>
</div>

<script is:inline>
  (function () {
    var bar = document.getElementById('reading-progress');
    if (!bar) return;

    function update() {
      var doc = document.documentElement;
      var scrollable = doc.scrollHeight - window.innerHeight;
      var ratio = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 1;
      bar.style.width = ratio * 100 + '%';
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  })();
</script>
</LayoutWrapper>
