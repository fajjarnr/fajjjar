---
import { getCollection } from 'astro:content';
import LayoutWrapper from '../../components/LayoutWrapper.astro';
import PageTitle from '../../components/PageTitle.astro';
import SectionContainer from '../../components/SectionContainer.astro';
import Link from '../../components/Link.astro';
import { formatDate, readingTime, slugTag } from '../../utils/blog';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const accentCycle = ['bg-cyan', 'bg-pink', 'bg-green', 'bg-red', 'bg-yellow'];
---

<LayoutWrapper title="Blog" description="All posts on the blog" url="/blog/">
  <SectionContainer>
    <PageTitle title="Blog" description={`${posts.length} posts and counting`} />

    <!-- Search -->
    <div class="mb-10">
      <label for="post-filter" class="mb-2 block font-mono text-xs font-bold uppercase tracking-tight text-ink/70 dark:text-paper/70">
        Filter posts
      </label>
      <input
        id="post-filter"
        type="search"
        placeholder="Type a title, summary, or tag..."
        autocomplete="off"
        class="w-full border-2 border-ink bg-white px-4 py-3 font-bold shadow-[5px_5px_0_#111111] placeholder:font-normal placeholder:text-ink/50 focus:outline-none focus:ring-0 dark:border-paper dark:bg-ink dark:text-paper dark:placeholder:text-paper/50"
      />
      <p id="filter-count" class="mt-3 text-sm font-bold text-ink/70 dark:text-paper/70">
        Showing all {posts.length} posts
      </p>
    </div>

    <ul id="post-list" class="grid gap-6 sm:grid-cols-2">
      {posts.map((post, i) => (
        <li
          class="post-item border-2 border-ink bg-white p-6 shadow-[5px_5px_0_#111111] transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-[1px_1px_0_#111111] dark:border-paper dark:bg-ink"
          data-search={`${post.data.title} ${post.data.summary ?? ''} ${post.data.tags.join(' ')}`.toLowerCase()}
        >
          <div class="flex flex-wrap items-center gap-3">
            <time datetime={post.data.date.toISOString()} class="border-2 border-ink px-2 py-1 font-mono text-xs font-black uppercase dark:border-paper">
              {formatDate(post.data.date)}
            </time>
            <span class={`border-2 border-ink px-2 py-1 font-mono text-xs font-black uppercase dark:border-paper ${accentCycle[i % accentCycle.length]}`}>
              {post.data.layout}
            </span>
            <span class="font-mono text-xs font-bold text-ink/70 dark:text-paper/70">
              {readingTime(post.body)} min
            </span>
          </div>

          <h2 class="mt-4 font-display font-black uppercase tracking-tight text-xl text-ink dark:text-paper sm:text-2xl">
            <Link href={`/blog/${post.slug}/`} class="text-ink dark:text-paper hover:underline decoration-2 underline-offset-4">
              {post.data.title}
            </Link>
          </h2>

          {post.data.summary && (
            <p class="mt-3 leading-relaxed text-ink/70 dark:text-paper/70">
              {post.data.summary}
            </p>
          )}

          <div class="mt-5 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <a
                href={`/tags/${slugTag(tag)}/`}
                class="inline-block border-2 border-ink bg-yellow px-2 py-1 font-mono text-xs font-bold uppercase text-ink transition-all hover:translate-x-[2px] hover:translate-y-[2px] dark:border-paper"
              >
                #{tag}
              </a>
            ))}
          </div>
        </li>
      ))}
    </ul>

    <p id="filter-empty" class="mt-8 hidden border-2 border-dashed border-ink p-6 font-bold dark:border-paper">
      No posts match your search.
    </p>
  </SectionContainer>
</LayoutWrapper>

<script is:inline>
  const input = document.getElementById('post-filter');
  const items = Array.from(document.querySelectorAll('.post-item'));
  const count = document.getElementById('filter-count');
  const empty = document.getElementById('filter-empty');
  const total = items.length;

  input?.addEventListener('input', () => {
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    for (const item of items) {
      const hit = !q || (item.dataset.search || '').includes(q);
      item.classList.toggle('hidden', !hit);
      if (hit) visible++;
    }
    if (count) count.textContent = q ? `Showing ${visible} of ${total} posts` : `Showing all ${total} posts`;
    empty?.classList.toggle('hidden', visible !== 0);
  });
</script>
