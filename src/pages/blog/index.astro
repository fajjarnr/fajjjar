---
import { getCollection } from 'astro:content';
import LayoutWrapper from '../../components/LayoutWrapper.astro';
import PageTitle from '../../components/PageTitle.astro';
import SectionContainer from '../../components/SectionContainer.astro';
import Link from '../../components/Link.astro';
import { formatDate, readingTime, slugTag } from '../../utils/blog';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const featured = posts[0];
const recent = posts.slice(1);
const accentCycle = ['bg-cyan', 'bg-pink', 'bg-green', 'bg-red', 'bg-yellow'];
---

<LayoutWrapper title="Writing on platform engineering" description="Practitioner notes on OpenShift, Kubernetes, automation, and running platforms in production." url="/blog/">
  <SectionContainer>
    <PageTitle title="Blog" description={`${posts.length} posts and counting`} />

    <!-- Search -->
    <div class="mb-10">
      <label for="post-filter" class="mb-2 block font-mono text-xs font-bold uppercase tracking-tight text-ink/70 dark:text-paper/70">
        Filter posts
      </label>
      <input
        id="post-filter"
        type="search"
        placeholder="Type a title, summary, or tag..."
        autocomplete="off"
        class="w-full border-2 border-ink bg-white px-4 py-3 font-bold shadow-brutal-md placeholder:font-normal placeholder:text-ink/50 focus:outline-none focus:ring-0 dark:border-paper dark:bg-ink dark:text-paper dark:placeholder:text-paper/50"
      />
      <div id="filter-status" role="status" class="readout readout--info mt-3">
        <div class="readout-head">
          <span class="readout-tag">Index</span>
          <span id="filter-status-text" class="ml-auto">Showing all {posts.length} posts</span>
        </div>
      </div>
    </div>

    <!-- Featured post -->
    {featured && (
      <article class="post-item mb-8 border-2 border-ink bg-white shadow-brutal-lg transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-brutal-xs dark:border-paper dark:bg-ink" data-search={`${featured.data.title} ${featured.data.summary ?? ''} ${featured.data.tags.join(' ')}`.toLowerCase()}>
        <div class="grid grid-cols-1 md:grid-cols-2">
          <div class="border-b-2 border-ink dark:border-paper md:border-b-0 md:border-r-2">
            <div class="flex flex-wrap items-center gap-3 p-6 pb-0">
              <span class="border-2 border-ink bg-pink px-2 py-1 font-mono text-xs font-black uppercase text-ink dark:border-paper dark:bg-pink dark:text-ink">
                Featured
              </span>
              <time datetime={featured.data.date.toISOString()} class="font-mono text-xs font-bold uppercase text-ink/70 dark:text-paper/70">
                {formatDate(featured.data.date)}
              </time>
              <span class="font-mono text-xs font-bold text-ink/70 dark:text-paper/70">
                {readingTime(featured.body)} min read
              </span>
            </div>
            <div class="p-6">
              <h2 class="font-display text-2xl font-black uppercase tracking-tight text-ink dark:text-paper sm:text-3xl break-words">
                <Link href={`/blog/${featured.slug}/`} class="text-ink dark:text-paper hover:underline decoration-2 underline-offset-4">
                  {featured.data.title}
                </Link>
              </h2>
              {featured.data.summary && (
                <p class="mt-3 leading-relaxed text-ink/70 dark:text-paper/70">
                  {featured.data.summary}
                </p>
              )}
              <div class="mt-5 flex flex-wrap gap-2">
                {featured.data.tags.map((tag) => (
                  <a
                    href={`/tags/${slugTag(tag)}/`}
                    class="inline-block border-2 border-ink bg-yellow px-2 py-1 font-mono text-xs font-bold uppercase text-ink transition-all hover:translate-x-[2px] hover:translate-y-[2px] dark:border-paper"
                  >
                    #{tag}
                  </a>
                ))}
              </div>
            </div>
          </div>
          <div class="flex items-center justify-center bg-paper-muted p-8 dark:bg-ink">
            <div class="text-center">
              <span class="block font-display text-6xl font-black uppercase leading-none tracking-tight text-ink sm:text-7xl dark:text-paper">
                {readingTime(featured.body)}
              </span>
              <span class="mt-2 block font-mono text-xs font-bold uppercase tracking-tight text-ink/70 dark:text-paper/70">
                min read
              </span>
            </div>
          </div>
        </div>
      </article>
    )}

    <!-- Recent posts grid -->
    <ul id="post-list" class="grid gap-6 sm:grid-cols-2">
      {recent.map((post, i) => (
        <li
          class="post-item border-2 border-ink bg-white p-6 shadow-brutal-md transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-brutal-xs dark:border-paper dark:bg-ink"
          data-search={`${post.data.title} ${post.data.summary ?? ''} ${post.data.tags.join(' ')}`.toLowerCase()}
        >
          <div class="flex flex-wrap items-center gap-3">
            <time datetime={post.data.date.toISOString()} class="border-2 border-ink px-2 py-1 font-mono text-xs font-black uppercase dark:border-paper">
              {formatDate(post.data.date)}
            </time>
            <span class={`border-2 border-ink px-2 py-1 font-mono text-xs font-black uppercase text-ink dark:border-paper dark:text-ink ${accentCycle[i % accentCycle.length]}`}>
              {readingTime(post.body)} min
            </span>
          </div>

          <h2 class="mt-4 font-display text-xl font-black uppercase tracking-tight text-ink dark:text-paper sm:text-2xl">
            <Link href={`/blog/${post.slug}/`} class="text-ink dark:text-paper hover:underline decoration-2 underline-offset-4">
              {post.data.title}
            </Link>
          </h2>

          {post.data.summary && (
            <p class="mt-3 leading-relaxed text-ink/70 dark:text-paper/70">
              {post.data.summary}
            </p>
          )}

          <div class="mt-5 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => (
              <a
                href={`/tags/${slugTag(tag)}/`}
                class="inline-block border-2 border-ink bg-cyan px-2 py-1 font-mono text-xs font-bold uppercase text-ink transition-all hover:translate-x-[2px] hover:translate-y-[2px] dark:border-paper"
              >
                #{tag}
              </a>
            ))}
          </div>
        </li>
      ))}
    </ul>

    <div id="filter-empty" class="readout readout--fault mt-8 hidden">
      <div class="readout-head">
        <span class="readout-tag">No signal</span>
      </div>
      <div class="readout-body">
        <p>
          No posts match &ldquo;<span id="filter-empty-term" class="normal-case"></span>&rdquo;.
        </p>
        <p class="mt-1 text-ink/70 dark:text-paper/70">
          Try a shorter term, or browse the tags.
        </p>
      </div>
    </div>
  </SectionContainer>
</LayoutWrapper>

<script is:inline>
  (function() {
    var input = document.getElementById('post-filter');
    var items = Array.from(document.querySelectorAll('.post-item'));
    var statusText = document.getElementById('filter-status-text');
    var empty = document.getElementById('filter-empty');
    var emptyTerm = document.getElementById('filter-empty-term');
    var total = items.length;

    input?.addEventListener('input', function() {
      var raw = input.value.trim();
      var q = raw.toLowerCase();
      var visible = 0;
      for (var i = 0; i < items.length; i++) {
        var item = items[i];
        var hit = !q || (item.dataset.search || '').includes(q);
        item.classList.toggle('hidden', !hit);
        if (hit) visible++;
      }
      if (statusText) {
        statusText.textContent = q
          ? visible + ' of ' + total + ' posts match'
          : 'Showing all ' + total + ' posts';
      }
      if (emptyTerm) emptyTerm.textContent = raw;
      empty?.classList.toggle('hidden', visible !== 0);
    });
  })();
</script>
