---
import { getCollection } from 'astro:content';
import LayoutWrapper from '../components/LayoutWrapper.astro';
import SectionContainer from '../components/SectionContainer.astro';
import Tag from '../components/Tag.astro';
import Link from '../components/Link.astro';
import { siteMetadata } from '../data/siteMetadata';
import { formatDate, readingTime, slugTag } from '../utils/blog';
import TopologyDiagram from '../components/TopologyDiagram.astro';
import Hero from '../components/Hero.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 5);

const allTags = [...new Set<string>(posts.flatMap((p) => p.data.tags))].sort();
const featured = posts[0];
const recent = posts.slice(1);
---

<LayoutWrapper title={siteMetadata.title} description={siteMetadata.description} url="/">
  <!-- Status bar: the positioning line, stated once, above the fold -->
  <div class="border-b-2 border-ink bg-yellow dark:border-paper">
    <div class="mx-auto flex max-w-[1180px] flex-wrap items-center gap-x-3 gap-y-1 px-4 py-2 sm:px-6">
      <span class="font-mono text-xs font-bold uppercase tracking-tight text-ink">Focus</span>
      <span class="font-mono text-xs font-bold uppercase tracking-tight text-ink/70">
        OpenShift · Multi-cluster · Automation
      </span>
    </div>
  </div>

  <!-- Hero -->
  <section class="border-b-4 border-ink dark:border-paper">
    <Hero />
  </section>

  <!-- Topic filter strip -->
  {allTags.length > 0 && (
    <div class="border-b-2 border-ink bg-paper-muted dark:border-paper dark:bg-ink">
      <div class="mx-auto max-w-[1180px] px-4 py-4 sm:px-6">
        <div class="flex flex-wrap items-center gap-2">
          <span class="font-mono text-xs font-bold uppercase text-ink/70 dark:text-paper/70">Topics:</span>
          {allTags.slice(0, 4).map((tag) => (
            <a
              href={`/tags/${slugTag(tag)}/`}
              class="inline-block border-2 border-ink bg-white px-3 py-1 font-mono text-xs font-bold uppercase text-ink transition-all hover:bg-yellow dark:border-paper dark:bg-ink dark:text-paper"
            >
              {tag}
            </a>
          ))}
          {allTags.length > 4 && (
            <a
              href="/tags"
              class="inline-block border-2 border-ink bg-cyan px-3 py-1 font-mono text-xs font-bold uppercase text-ink transition-all hover:bg-yellow dark:border-paper dark:bg-cyan dark:text-ink"
            >
              +{allTags.length - 4} more
            </a>
          )}
        </div>
      </div>
    </div>
  )}

  <!-- Featured post -->
  {featured && (
    <SectionContainer>
      <div class="border-2 border-ink bg-yellow p-6 shadow-brutal-lg dark:border-paper sm:p-8 reveal">
        <div class="flex flex-wrap items-center gap-3">
          <span class="border-2 border-ink bg-pink px-2 py-1 font-mono text-xs font-bold uppercase text-ink dark:border-paper dark:bg-pink dark:text-ink">
            Featured
          </span>
          <time datetime={featured.data.date.toISOString()} class="font-mono text-xs font-bold uppercase text-ink/70">
            {formatDate(featured.data.date)}
          </time>
        </div>
        <h2 class="mt-4 font-display font-black uppercase tracking-tight text-3xl text-ink sm:text-4xl">
          <Link href={`/blog/${featured.slug}/`} class="text-ink hover:underline decoration-2 underline-offset-4">
            {featured.data.title}
          </Link>
        </h2>
        {featured.data.summary && (
          <p class="mt-3 max-w-2xl leading-relaxed text-ink/70">{featured.data.summary}</p>
        )}
        <div class="mt-5 flex flex-wrap gap-2">
          {featured.data.tags.map((tag) => <Tag tag={slugTag(tag)} />)}
        </div>
      </div>
    </SectionContainer>
  )}

  <!-- Recent posts -->
  <SectionContainer>
    <div class="flex items-end justify-between gap-4 border-b-4 border-ink pb-4 dark:border-paper">
      <h2 class="font-display font-black uppercase tracking-tight text-3xl text-ink dark:text-paper sm:text-4xl">
        Latest writing
      </h2>
      <span class="border-2 border-ink bg-green px-3 py-1 font-mono text-xs font-black text-ink dark:border-paper dark:bg-green dark:text-ink">
        {recent.length} posts
      </span>
    </div>

    {recent.length === 0 && (
      <p class="mt-8 border-2 border-dashed border-ink p-6 font-bold dark:border-paper">
        No posts yet.
      </p>
    )}

    <ul class="stagger mt-10 grid gap-6 sm:grid-cols-2">
      {recent.map((post, i) => (
        <li
          class={`border-2 border-ink bg-white p-6 shadow-brutal-md transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-brutal-xs dark:border-paper dark:bg-ink ${i === 0 ? 'sm:col-span-2' : ''}`}
        >
          <div class="flex flex-wrap items-center gap-3">
            <time datetime={post.data.date.toISOString()} class="border-2 border-ink px-2 py-1 font-mono text-xs font-black uppercase dark:border-paper">
              {formatDate(post.data.date)}
            </time>
            <span class="border-2 border-ink bg-cyan px-2 py-1 font-mono text-xs font-black uppercase text-ink dark:border-paper dark:bg-cyan dark:text-ink">
              {readingTime(post.body)} min read
            </span>
          </div>
          <h3 class="mt-4 font-display font-black uppercase tracking-tight text-xl text-ink dark:text-paper sm:text-2xl">
            <Link href={`/blog/${post.slug}/`} class="text-ink dark:text-paper hover:underline decoration-2 underline-offset-4">
              {post.data.title}
            </Link>
          </h3>
          {post.data.summary && (
            <p class="mt-3 leading-relaxed text-ink/70 dark:text-paper/70">
              {post.data.summary}
            </p>
          )}
          <div class="mt-5 flex flex-wrap gap-2">
            {post.data.tags.map((tag) => <Tag tag={slugTag(tag)} />)}
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-12 flex justify-center">
      <a
        href="/blog"
        class="border-2 border-ink bg-pink px-8 py-4 font-black uppercase text-ink shadow-brutal-lg transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-brutal-xs dark:border-paper dark:bg-pink dark:text-ink"
      >
        View all posts
      </a>
    </div>
  </SectionContainer>
</LayoutWrapper>
