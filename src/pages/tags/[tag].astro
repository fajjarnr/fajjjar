---
import { getCollection, type CollectionEntry } from 'astro:content';
import LayoutWrapper from '../../components/LayoutWrapper.astro';
import SectionContainer from '../../components/SectionContainer.astro';
import { formatDate, readingTime, slugTag } from '../../utils/blog';
import Link from '../../components/Link.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  const byTag = new Map<string, { label: string; posts: CollectionEntry<'blog'>[] }>();
  for (const post of posts) {
    for (const tag of post.data.tags) {
      const slug = slugTag(tag);
      const entry = byTag.get(slug) ?? { label: tag, posts: [] };
      entry.posts.push(post);
      byTag.set(slug, entry);
    }
  }

  return [...byTag.entries()].map(([slug, { label, posts: tagged }]) => ({
    params: { tag: slug },
    props: { tag: label, posts: tagged },
  }));
}

interface Props {
  tag: string;
  posts: CollectionEntry<'blog'>[];
}

const { tag, posts } = Astro.props;

posts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

---

<LayoutWrapper title={`${tag} posts — platform engineering notes`} description={`Every post tagged ${tag} on the blog: practitioner notes on OpenShift, Kubernetes, automation, and production platforms.`} url={`/tags/${slugTag(tag)}/`}>
  <SectionContainer>
    <a
      href="/tags/"
      class="inline-block border-2 border-ink bg-cyan px-4 py-2 text-sm font-black uppercase text-ink transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-brutal-xs dark:border-paper"
    >
      &larr; All tags
    </a>

    <div class="mt-8 border-b-4 border-ink pb-4 dark:border-paper">
      <h1 class="font-display font-black uppercase tracking-tight text-4xl text-ink dark:text-paper sm:text-5xl">
        Posts tagged &ldquo;{tag}&rdquo;
      </h1>
      <p class="mt-3 font-bold text-ink/70 dark:text-paper/70">
        {posts.length} {posts.length === 1 ? 'post' : 'posts'}
      </p>
    </div>

    <ul class="stagger mt-10 space-y-6">
      {posts.map((post) => (
        <li class="border-2 border-ink bg-white p-6 shadow-brutal-md transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-brutal-xs dark:border-paper dark:bg-ink">
          <div class="flex flex-wrap items-center gap-3 text-xs font-black uppercase">
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
            <span class="border-2 border-ink bg-yellow px-2 py-1 text-ink dark:border-paper">
              {readingTime(post.body)} min read
            </span>
          </div>

          <h2 class="mt-4 font-display font-black uppercase tracking-tight text-2xl text-ink dark:text-paper">
            <Link href={`/blog/${post.slug}/`} class="text-ink dark:text-paper">
              {post.data.title}
            </Link>
          </h2>

          {post.data.summary && (
            <p class="mt-3 leading-relaxed text-ink/70 dark:text-paper/70">{post.data.summary}</p>
          )}

          <div class="mt-5 flex flex-wrap gap-2">
            {post.data.tags.map((t) => (
              <a
                href={`/tags/${slugTag(t)}/`}
                class="inline-block border-2 border-ink bg-green px-3 py-1 text-sm font-bold text-ink transition-all hover:translate-x-[3px] hover:translate-y-[3px] hover:shadow-brutal-xs dark:border-paper"
              >
                #{t}
              </a>
            ))}
          </div>
        </li>
      ))}
    </ul>
  </SectionContainer>
</LayoutWrapper>